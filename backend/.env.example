NODE_ENV=development
PORT=3001
MONGO_URI=mongodb://localhost:27017/gsmhub
REDIS_URI=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
# Password for the seeded admin account (admin@gsmhub.com) — required by the
# seed scripts when the admin user does not exist yet. No default: seeds fail without it.
ADMIN_PASSWORD=replace-with-a-strong-password
FRONTEND_URL=http://localhost:3000
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.gsmhub.com
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=100kb
