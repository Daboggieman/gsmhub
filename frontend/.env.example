# Server-side (SSR) calls and the /api proxy target (next.config.ts).
# Local dev default works without this (http://localhost:3001).
# BACKEND_URL=http://localhost:3001

# Public site origin — used by robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy browser-side override for the API origin. LEAVE UNSET in
# deployments: the browser should use the same-origin /api proxy so the
# auth cookie stays first-party (Safari/Brave block third-party cookies).
# NEXT_PUBLIC_API_URL=http://localhost:3001

# After AdSense approval (see docs/monetization-setup.md):
# NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=pub-XXXXXXXXXXXXXXXX
